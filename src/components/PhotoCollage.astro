---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

// Drop up to 4 photos into src/assets/photos/ (jpg, png, webp).
// The file name becomes the alt text: "psiml-serbia-2026.jpg" -> "psiml serbia 2026".
const files = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/photos/*.{jpg,jpeg,png,webp,avif}",
  { eager: true }
);

const photos = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .slice(0, 4)
  .map(([path, mod]) => ({
    src: mod.default,
    alt: path.split("/").pop()!.replace(/\.[^.]+$/, "").replace(/[-_]+/g, " "),
  }));

// Placeholder frames while developing, so the layout is visible before photos exist.
const showPlaceholders = photos.length === 0 && import.meta.env.DEV;
const count = showPlaceholders ? 4 : photos.length;

type Props = { class?: string };
const { class: className } = Astro.props;
---

{
  count > 0 && (
    <div class:list={["collage", className]} aria-label="Photos">
      {Array.from({ length: count }, (_, i) => (
        <figure class={`photo photo-${i + 1}`}>
          {photos[i] ? (
            <Image
              src={photos[i].src}
              alt={photos[i].alt}
              width={320}
              class="h-full w-full object-cover"
            />
          ) : (
            <span class="placeholder font-ui">photo {i + 1}</span>
          )}
        </figure>
      ))}
    </div>
  )
}

<style>
  /* Small prints scattered on a desk: slightly tilted, overlapping. */
  .collage {
    position: relative;
    width: 16.5rem;
    height: 19.5rem;
    flex-shrink: 0;
  }
  .photo {
    position: absolute;
    width: 8.5rem;
    aspect-ratio: 4 / 5;
    margin: 0;
    padding: 0.35rem 0.35rem 1.1rem;
    background: #fff;
    border-radius: 3px;
    box-shadow:
      0 1px 3px rgb(0 0 0 / 0.12),
      0 6px 16px rgb(0 0 0 / 0.1);
    transition:
      transform 0.25s ease,
      z-index 0s;
  }
  .photo :global(img) {
    border-radius: 2px;
  }
  .photo-1 {
    top: 0;
    left: 0;
    transform: rotate(-6deg);
  }
  .photo-2 {
    top: 1.2rem;
    right: 0;
    transform: rotate(5deg);
  }
  .photo-3 {
    bottom: 0;
    left: 0;
    transform: rotate(3deg);
  }
  .photo-4 {
    bottom: 0.4rem;
    right: 0;
    transform: rotate(-4deg);
  }
  .photo:hover {
    z-index: 10;
    transform: rotate(0deg) scale(1.06);
  }
  .placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    border: 2px dashed #c8c8c8;
    border-radius: 2px;
    color: #9a9a9a;
    font-size: 0.8rem;
  }

  /* Phones: a small overlapping row instead of the scattered pile. */
  @media (max-width: 767px) {
    .collage {
      display: flex;
      width: auto;
      height: auto;
      padding: 0.5rem 0 0.75rem 0.5rem;
    }
    .photo {
      position: relative;
      inset: auto;
      width: 5.5rem;
      margin-inline-start: -0.6rem;
    }
    .photo:first-child {
      margin-inline-start: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo {
      transition: none;
    }
  }
</style>
