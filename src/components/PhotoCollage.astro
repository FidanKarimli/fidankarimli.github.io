---
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";

// Drop 2 photos into src/assets/photos/ (jpg, png, webp); they are taken in name order.
// Add a caption below, keyed by file name. Without one, the file name is used as alt text:
// "psiml-serbia-2026.jpg" -> "psiml serbia 2026".
const captions: Record<string, string> = {
  "photo-collage.png":
    "PSI:ML 2026, Serbia: some of my best days, learning at full capacity and enjoying every minute of it, together.",
};
const files = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/photos/*.{jpg,jpeg,png,webp,avif}",
  { eager: true }
);

const photos = await Promise.all(
  Object.entries(files)
    .sort(([a], [b]) => a.localeCompare(b))
    .slice(0, 2)
    .map(async ([path, mod]) => {
      const name = path.split("/").pop()!;
      const caption = captions[name];
      return {
        src: mod.default,
        // Larger version shown when the photo is clicked.
        large: (await getImage({ src: mod.default, width: 1400 })).src,
        caption,
        alt: caption ?? name.replace(/\.[^.]+$/, "").replace(/[-_]+/g, " "),
      };
    })
);

// Placeholder frames while developing, so the layout is visible before photos exist.
const showPlaceholders = photos.length === 0 && import.meta.env.DEV;
const count = showPlaceholders ? 2 : photos.length;

type Props = { class?: string };
const { class: className } = Astro.props;
---

{
  count > 0 && (
    <div class:list={["collage", { single: count === 1 }, className]}>
      {Array.from({ length: count }, (_, i) =>
        photos[i] ? (
          <button
            type="button"
            class:list={["photo", `photo-${i + 1}`, { captioned: photos[i].caption }]}
            data-large={photos[i].large}
            data-alt={photos[i].alt}
            data-caption={photos[i].caption ?? ""}
            aria-label={`Open photo: ${photos[i].alt}`}
          >
            <span
              class="block"
              style={`aspect-ratio: ${photos[i].src.width} / ${photos[i].src.height}`}
            >
              <Image
                src={photos[i].src}
                alt={photos[i].alt}
                width={640}
                class="h-full w-full object-contain"
              />
            </span>
            {photos[i].caption && <span class="caption">{photos[i].caption}</span>}
          </button>
        ) : (
          <div class={`photo photo-${i + 1}`}>
            <span class="placeholder font-ui">photo {i + 1}</span>
          </div>
        )
      )}
    </div>
  )
}

{
  photos.length > 0 && (
    <dialog id="photo-viewer" class="viewer">
      <form method="dialog">
        <button class="close font-ui" aria-label="Close">
          ×
        </button>
      </form>
      <img alt="" />
      <p class="viewer-caption"></p>
    </dialog>
  )
}

<script>
  function initPhotoViewer() {
    const viewer = document.querySelector<HTMLDialogElement>("#photo-viewer");
    const img = viewer?.querySelector("img");
    const caption = viewer?.querySelector(".viewer-caption");
    if (!viewer || !img || !caption) return;

    document.querySelectorAll<HTMLButtonElement>(".collage button.photo").forEach(btn => {
      btn.addEventListener("click", () => {
        img.src = btn.dataset.large ?? "";
        img.alt = btn.dataset.alt ?? "";
        caption.textContent = btn.dataset.caption ?? "";
        viewer.showModal();
      });
    });

    // Clicking anywhere (backdrop or photo) closes it; Esc works natively.
    viewer.addEventListener("click", () => viewer.close());
  }

  document.addEventListener("astro:page-load", initPhotoViewer);
</script>

<style>
  /* Two small prints on a desk: slightly tilted, overlapping. */
  .collage {
    position: relative;
    width: 14rem;
    height: 14.5rem;
    flex-shrink: 0;
  }
  .photo {
    position: absolute;
    width: 9rem;
    max-height: 12rem;
    aspect-ratio: 4 / 5;
    margin: 0;
    padding: 0.35rem 0.35rem 1.1rem;
    background: #fff;
    border-radius: 3px;
    box-shadow:
      0 1px 3px rgb(0 0 0 / 0.12),
      0 6px 16px rgb(0 0 0 / 0.1);
    transition: transform 0.25s ease;
  }
  button.photo {
    cursor: zoom-in;
  }
  .photo :global(img) {
    border-radius: 2px;
  }
  .photo-1 {
    top: 0;
    left: 0;
    transform: rotate(-6deg);
  }
  .photo-2 {
    bottom: 0;
    right: 0;
    transform: rotate(5deg);
  }
  /* One photo: a single, larger print. */
  .single {
    width: 17rem;
    height: auto;
  }
  .single .photo {
    position: relative;
    width: 100%;
    max-height: none;
    transform: rotate(3deg);
  }
  .photo.captioned {
    aspect-ratio: auto;
    padding-bottom: 0.6rem;
  }
  /* Handwritten-style note on the white strip of the print. */
  .caption {
    display: block;
    margin-top: 0.5rem;
    color: #4a4a4a;
    font-size: 0.8rem;
    font-style: italic;
    line-height: 1.35;
    text-align: center;
  }

  .photo:hover,
  .photo:focus-visible {
    z-index: 10;
    transform: rotate(0deg) scale(1.06);
  }
  .placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    border: 2px dashed #c8c8c8;
    border-radius: 2px;
    color: #9a9a9a;
    font-size: 0.8rem;
  }

  /* Enlarged photo */
  .viewer {
    max-width: min(92vw, 1100px);
    max-height: 90vh;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    overflow: visible;
    cursor: zoom-out;
  }
  .viewer::backdrop {
    background: rgb(0 0 0 / 0.75);
  }
  .viewer img {
    display: block;
    max-width: 100%;
    max-height: 90vh;
    border-radius: 6px;
  }
  .viewer-caption {
    margin-top: 0.75rem;
    color: #f0f0f0;
    font-style: italic;
    text-align: center;
  }
  .viewer-caption:empty {
    display: none;
  }
  .close {
    position: absolute;
    top: -2.25rem;
    right: 0;
    color: #fff;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }

  /* Phones: the two prints sit side by side under the intro. */
  @media (max-width: 767px) {
    .collage {
      display: flex;
      gap: 0.5rem;
      width: auto;
      height: auto;
      padding: 0.5rem 0 0.75rem 0.25rem;
    }
    .photo {
      position: relative;
      inset: auto;
      width: 7rem;
    }
    .single {
      padding: 0.75rem 0.5rem 1rem;
    }
    .single .photo {
      width: min(20rem, 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo {
      transition: none;
    }
  }
</style>
