---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath, body = "" } = Astro.props;

const { title, description, tags, ...props } = data;

const words = body.replace(/```[\s\S]*?```/g, " ").split(/\s+/).filter(Boolean);
const locale = Astro.currentLocale ?? config.site.lang;
const minutes = Math.max(1, Math.round(words.length / 220));
---

<li
  class="border-muted hover:border-accent my-5 border-s-2 py-1 ps-4 transition-colors"
>
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={[
      "text-accent inline-block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading transition:name={toTransitionName(id)}>
      {title}
    </Heading>
  </a>
  <div class="flex flex-wrap items-center gap-x-2">
    <Datetime {...props} />
    <span class="font-ui text-muted-foreground text-sm">· {minutes} min read</span>
  </div>
  <p>{description}</p>
  {
    tags.length > 0 && (
      <p class="font-ui text-muted-foreground mt-1 flex flex-wrap gap-x-3 text-sm">
        {tags.map(tag => (
          <a
            href={getRelativeLocaleUrl(locale, `tags/${slugifyStr(tag)}`)}
            class="hover:text-accent"
          >
            #{tag}
          </a>
        ))}
      </p>
    )
  }
</li>
