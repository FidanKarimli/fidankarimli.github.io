---
/**
 * A soft northern-lights glow across the top of a page.
 *
 * Pure CSS, no JavaScript: a few blurred colour ribbons that drift very slowly. Place it as
 * the first thing in the page; it sits behind everything, ignores clicks, and fades out
 * towards the bottom so it never competes with the text.
 *
 * Dark mode: glowing greens, teals and violets on black.
 * Light mode: the same colours, much paler.
 * Reduced motion: the glow stays still.
 */
---

<div class="aurora" aria-hidden="true">
  <span class="ribbon r1"></span>
  <span class="ribbon r2"></span>
  <span class="ribbon r3"></span>
  <span class="ribbon r4"></span>
</div>

<style>
  .aurora {
    position: absolute;
    inset: 0 0 auto 0;
    height: 32rem;
    overflow: hidden;
    pointer-events: none;
    z-index: -10;
    isolation: isolate;
    -webkit-mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
  }

  .ribbon {
    position: absolute;
    border-radius: 50%;
    filter: blur(72px);
    opacity: 0.38;
    will-change: transform;
  }

  .r1 {
    left: -12%;
    top: -9rem;
    width: 62%;
    height: 17rem;
    background: #34d399;
    animation: drift-a 24s ease-in-out infinite alternate;
  }
  .r2 {
    left: 22%;
    top: -7rem;
    width: 56%;
    height: 16rem;
    background: #22d3ee;
    animation: drift-b 30s ease-in-out infinite alternate;
  }
  .r3 {
    right: -12%;
    top: -8rem;
    width: 58%;
    height: 17rem;
    background: #a78bfa;
    animation: drift-c 27s ease-in-out infinite alternate;
  }
  .r4 {
    left: 8%;
    top: -3rem;
    width: 42%;
    height: 9rem;
    background: #f0abfc;
    opacity: 0.26;
    animation: drift-b 34s ease-in-out infinite alternate-reverse;
  }

  /* On black the colours can glow: blend them like light. */
  :global([data-theme="dark"]) .ribbon {
    opacity: 0.5;
    mix-blend-mode: screen;
  }
  :global([data-theme="dark"]) .r4 {
    opacity: 0.32;
  }

  @media (max-width: 640px) {
    .aurora { height: 26rem; }
    .ribbon { filter: blur(56px); }
    .r1 { width: 95%; }
    .r2 { width: 90%; left: 15%; }
    .r3 { width: 90%; }
    .r4 { width: 70%; }
  }

  @keyframes drift-a {
    from { transform: translate3d(0, 0, 0) rotate(-3deg) scale(1); }
    to { transform: translate3d(14%, 2rem, 0) rotate(3deg) scale(1.18); }
  }
  @keyframes drift-b {
    from { transform: translate3d(-8%, 0.5rem, 0) rotate(2deg) scale(1.1); }
    to { transform: translate3d(10%, 2.5rem, 0) rotate(-4deg) scale(0.95); }
  }
  @keyframes drift-c {
    from { transform: translate3d(6%, 1rem, 0) rotate(3deg) scale(0.98); }
    to { transform: translate3d(-14%, 0, 0) rotate(-3deg) scale(1.2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ribbon { animation: none; }
  }
</style>
