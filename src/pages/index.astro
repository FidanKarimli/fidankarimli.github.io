---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProfileLinks from "@/components/ProfileLinks.astro";
import PostTile from "@/components/PostTile.astro";
import PhotoPileSort from "@/components/PhotoPileSort.tsx";
import Highlight from "@/components/Highlight.tsx";
import GlyphBackground from "@/components/GlyphBackground.tsx";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts;
const galleryImages = [
  { src: "/images/gallery/transit-hack.jpg", alt: "Our team holding the 1st place cheque in the Urban Planning category at Transit Hack" },
  { src: "/images/gallery/weun-summer-school.jpg", alt: "Me in front of the 2025 Worldwide Energy University Network Summer School board in Beijing" },
  { src: "/images/gallery/teknofest.jpg", alt: "Holding the Baku Higher Oil School flag at Teknofest" },
  { src: "/images/gallery/certificates.jpg", alt: "Three of us holding certificates at Baku Higher Oil School" },
  { src: "/images/gallery/maire-winners.jpg", alt: "Block Power team with the 3,000 AZN winner cheque for the energy transition challenge" },
];
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <div class="glyph-bg" aria-hidden="true">
    <GlyphBackground client:idle className="absolute inset-0 text-foreground" />
  </div>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <div class="md:flex md:items-start md:gap-8">
        <div class="min-w-0 flex-1">
          <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
            Hey, I'm Fidan.
          </h1>
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="inline-block"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss
              width={20}
              height={20}
              class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
            />
            <span class="sr-only">RSS Feed</span>
          </a>

          <p>
            I'm an AI engineer at the National AI Center of Azerbaijan, where I
            adapt large language models to Azerbaijani legal text, from
            domain-adaptive pretraining on 56,000+ laws to OCR for court
            evidence documents. I also do research on recommender systems with{" "}
            <a
              class="hover:text-accent underline decoration-dashed underline-offset-4"
              href="https://web.itu.edu.tr/yyaslan/">Prof. Yusuf Yaslan</a
            >{" "}at Istanbul Technical University, building graph neural network
            methods for cross-domain recommendation.
          </p>
          <ProfileLinks />
        </div>
        <img
          src="/images/me.jpg"
          alt="Me at the Future Energy Leaders Summer School in Beijing"
          class="border-border mt-4 aspect-[4/3] w-full max-w-xs shrink-0 rounded-lg border object-cover shadow-sm md:mt-8 md:aspect-[4/5] md:w-64 md:object-[71%_50%]"
        />
      </div>
      <p class="mt-8">I'm currently interested in:</p>
      <ul class="marker:text-accent mt-2 list-disc space-y-1.5 pl-5 sm:columns-2">
        <li><Highlight client:visible text="information retrieval" /></li>
        <li><Highlight client:visible text="graph neural networks" /></li>
        <li><Highlight client:visible text="recommender systems" /></li>
        <li><Highlight client:visible text="low-resource NLP" /></li>
        <li><Highlight client:visible text="LLMs" /></li>
        <li><Highlight client:visible text="scientific ML" /></li>
      </ul>
      <p class="mt-4">
        I write about them on the{" "}
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "posts")}
        >
          blog
        </LinkButton>, with small interactive pictures.
      </p>
      <p class="mt-6">
        I graduated from Baku Higher Oil School with a bachelor's degree in
        Process Automation Engineering, as a Presidential Scholar (top 0.06% in
        the national university entrance exam). My thesis, ClimNODE, applied
        Neural ODEs to climate dynamics under noisy observations. Before moving
        into AI, I worked as a data analyst at AGA Group and mentored students
        in data science.
      </p>
      <p class="mt-2">
        Outside work, I led the Data Science Club at Baku Higher Oil School and
        serve as the Azerbaijan ambassador for Women in Data Science. I have
        also taken part in the Petnica Summer Institute of Machine Learning in
        Serbia and the Future Energy Leaders Summer School in Beijing.
      </p>
      <p class="mt-5">
        I'm always happy to collaborate on these topics. Feel free to write to
        me at{" "}
        <a
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href="mailto:karimlifidan@outlook.com">karimlifidan@outlook.com</a
        >.
      </p>
    </section>

    {/* Draft, hidden for now: "Some moments" photo pile. Remove the comment markers to bring it back.
    <section id="moments" class="border-border border-b py-10">
      <h2 class="text-2xl font-semibold tracking-wide">Some moments</h2>
      <p class="mt-2 text-sm opacity-70">Scroll inside the pile to toss the photos down.</p>
      <PhotoPileSort
        client:visible
        images={galleryImages}
        count={galleryImages.length}
        size={0.4}
        length={6}
        className="mx-auto mt-6 max-w-md rounded-lg border border-border"
      />
    </section>
    */}

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>

          <ul class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <PostTile {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

<style>
  /* A quiet field of letters behind the top of the page. Sits behind everything and fades out. */
  .glyph-bg {
    position: absolute;
    inset: 0 0 auto 0;
    height: 34rem;
    z-index: -10;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
  }
</style>
