---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProfileLinks from "@/components/ProfileLinks.astro";
import PhotoCollage from "@/components/PhotoCollage.astro";
import PostTile from "@/components/PostTile.astro";
import GlyphBackground from "@/components/GlyphBackground.tsx";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts;
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <div class="glyph-bg" aria-hidden="true">
    <GlyphBackground client:idle className="absolute inset-0 text-foreground" />
  </div>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <div class="md:flex md:items-start md:gap-8">
        <div class="min-w-0 flex-1">
          <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
            Hey, I'm Fidan.
          </h1>
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="inline-block"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss
              width={20}
              height={20}
              class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
            />
            <span class="sr-only">RSS Feed</span>
          </a>

          <p>
            I'm an AI engineer from Baku, Azerbaijan. I work on language models
            for Azerbaijani and do research on graph learning and protein
            models. On this blog I explain what I learn, with small interactive
            pictures.
          </p>
          <p class="mt-2">
            Right now I'm a Junior AI Engineer at the National AI Center of
            Azerbaijan, where I adapt language models to Azerbaijani law. I also
            do research on recommender systems with Prof. Yusuf Yaslan at
            Istanbul Technical University. I studied Process Automation
            Engineering at Baku Higher Oil School. More on the{" "}
            <LinkButton
              class="hover:text-accent underline decoration-dashed underline-offset-4"
              href={getRelativeLocaleUrl(locale, "about")}
            >
              about page
            </LinkButton>{" "}
            and in my{" "}
            <LinkButton
              class="hover:text-accent underline decoration-dashed underline-offset-4"
              href="/cv.pdf"
            >
              CV
            </LinkButton>
            .
          </p>
          <ProfileLinks />
        </div>
        <PhotoCollage class="mt-4 md:mt-16" />
      </div>
      <h2 class="mt-8 text-xl font-semibold tracking-wide">
        Research interests
      </h2>
      <ul class="mt-2 list-disc space-y-1 ps-5">
        <li>
          <strong>Graph learning and recommender systems</strong>: suggesting
          the right items to users who have little history.
        </li>
        <li>
          <strong>Language models for low-resource languages</strong>: adapting
          language models and search to Azerbaijani and to law.
        </li>
        <li>
          <strong>Self-supervised learning for science</strong>: learning from
          unlabelled graphs and proteins, like my JEPA project on protein
          stability.
        </li>
      </ul>
    </section>

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <PostTile {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

<style>
  /* A quiet field of letters behind the top of the page. Sits behind everything and fades out. */
  .glyph-bg {
    position: absolute;
    inset: 0 0 auto 0;
    height: 34rem;
    z-index: -10;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 35%, transparent 100%);
  }
</style>
