---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hey, I'm Fidan.</h1>
			<p>
				I am a ML Engineer (somehow).
			</p>
			<p>
				I write about machine learning concepts with math and interactive visualizations -
				the kind of explanations I wish existed when I was learning. 
				Think <a href="https://colah.github.io/">colah's blog</a>, but in my own voice.
			</p>
			
			<p>
				<a href="/blog">Read the blog →</a>
			</p>
		</main>
		<Footer />
	</body>
</html>