---
type Props = {
  title: string;
};

const { title } = Astro.props;
const subject = encodeURIComponent(`Feedback: ${title}`);
const issueTitle = encodeURIComponent(`Feedback: ${title}`);
---

<aside
  data-pagefind-ignore
  aria-labelledby="feedback-title"
  class="font-ui border-muted my-8 rounded-lg border border-dashed p-5"
>
  <p id="feedback-title" class="font-semibold">Feedback welcome</p>
  <p class="text-muted-foreground mt-1 text-sm">
    Spotted a mistake, have a question, or know a paper I should read? I would
    really like to hear it.
  </p>
  <div class="mt-3 flex flex-wrap gap-2 text-sm">
    <a
      href={`mailto:fidankarimli152004@gmail.com?subject=${subject}`}
      class="border-muted hover:border-accent hover:text-accent rounded-full border px-3 py-1"
    >
      Email me
    </a>
    <a
      href={`https://github.com/FidanKarimli/fidankarimli.github.io/issues/new?title=${issueTitle}`}
      class="border-muted hover:border-accent hover:text-accent rounded-full border px-3 py-1"
    >
      Open a GitHub issue
    </a>
  </div>
</aside>
